generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id          String        @id @default(cuid())
  userId      String
  label       String
  category    String?
  shortCode   String        @unique @default(cuid())
  status      ItemStatus    @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  description String?
  reports     FoundReport[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanEvents  ScanEvent[]

  @@index([userId, status])
}

model ScanEvent {
  id        String       @id @default(cuid())
  itemId    String
  ipHash    String?
  userAgent String?
  createdAt DateTime     @default(now())
  report    FoundReport?
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model FoundReport {
  id             String            @id @default(cuid())
  itemId         String
  scanEventId    String?           @unique
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  message        String?
  finderContact  String?
  manualLocation String?
  status         ReportStatus      @default(NEW)
  createdAt      DateTime          @default(now())
  item           Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  scanEvent      ScanEvent?        @relation(fields: [scanEventId], references: [id])
  notifications  NotificationLog[]

  @@index([itemId, status])
}

model NotificationLog {
  id         String              @id @default(cuid())
  reportId   String
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  attempts   Int                 @default(0)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())
  providerId String?             @unique
  report     FoundReport         @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model WebhookConfig {
  id           String   @id @default(cuid())
  userId       String
  url          String
  secret       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  failureCount Int      @default(0)

  @@index([userId])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  items         Item[]
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ItemStatus {
  ACTIVE
  ARCHIVED
  LOST
}

enum ReportStatus {
  NEW
  VIEWED
  RESOLVED
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  PROCESSING
  DELIVERED
}
